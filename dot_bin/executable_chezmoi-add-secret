#!/usr/bin/env bash
#
# chezmoi-add-secret — add a secret-backed env var to zsh + fish via chezmoi.
#
# For each call, this:
#   1. Creates ~/.secrets/<file> with 600 perms (prompts silently for value).
#      If file exists, re-uses it and fixes perms to 600.
#   2. Appends loader line(s) to chezmoi's dot_zshenv + fish config.fish
#      (idempotent — skips ENV_NAMEs already present).
#   3. Runs `chezmoi apply` scoped to just zshenv + fish config
#      (avoids TTY prompts on unrelated managed files).
#   4. Commits the chezmoi changes with a conventional-commit message.
#      Use --no-commit to skip.
#
# Open a fresh shell afterward (exec zsh -l / exec fish -l) to pick up the var.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  chezmoi-add-secret <ENV_NAME> [<ENV_NAME2> ...]
  chezmoi-add-secret --file <filename> <ENV_NAME> [<ENV_NAME2> ...]
  chezmoi-add-secret [--no-commit] <ENV_NAME>

Options:
  --file, -f    Secret filename under ~/.secrets/. If omitted, derived from
                the first ENV_NAME (ANTHROPIC_API_KEY -> anthropic-api-key).
  --no-commit   Skip the git commit step in the chezmoi source repo.
  -h, --help    This help.

Multiple ENV_NAMEs share one secret file, useful for SDK aliases. Example:
  chezmoi-add-secret --file gemini-api-key GEMINI_API_KEY GOOGLE_AI_API_KEY

Basic example:
  chezmoi-add-secret ANTHROPIC_API_KEY
EOF
  exit 1
}

SECRET_FILE=""
ENV_NAMES=()
DO_COMMIT=1

while (( $# )); do
  case "$1" in
    --file|-f)   SECRET_FILE="$2"; shift 2 ;;
    --no-commit) DO_COMMIT=0; shift ;;
    -h|--help)   usage ;;
    -*)          echo "Unknown flag: $1" >&2; usage ;;
    *)           ENV_NAMES+=("$1"); shift ;;
  esac
done
(( ${#ENV_NAMES[@]} )) || usage

# Derive filename if not supplied: ANTHROPIC_API_KEY -> anthropic-api-key
if [[ -z "$SECRET_FILE" ]]; then
  SECRET_FILE=$(echo "${ENV_NAMES[0]}" | tr '[:upper:]_' '[:lower:]-')
fi

SECRETS_DIR="$HOME/.secrets"
SECRET_PATH="$SECRETS_DIR/$SECRET_FILE"
CHEZMOI_SRC=$(chezmoi source-path)
ZSHENV="$CHEZMOI_SRC/dot_zshenv"
FISH_CONF="$CHEZMOI_SRC/private_dot_config/private_fish/config.fish"

[[ -f "$ZSHENV"    ]] || { echo "Missing: $ZSHENV" >&2; exit 1; }
[[ -f "$FISH_CONF" ]] || { echo "Missing: $FISH_CONF" >&2; exit 1; }

mkdir -p "$SECRETS_DIR" && chmod 700 "$SECRETS_DIR"

# --- Step 1: secret file ----------------------------------------------------
if [[ ! -f "$SECRET_PATH" ]]; then
  echo "Creating $SECRET_PATH"
  read -rsp "Paste secret value (input hidden; blank = empty file, edit later): " KEY_VAL
  echo
  umask 077
  if [[ -n "$KEY_VAL" ]]; then
    printf '%s' "$KEY_VAL" > "$SECRET_PATH"
  else
    touch "$SECRET_PATH"
  fi
  chmod 600 "$SECRET_PATH"
  unset KEY_VAL
else
  chmod 600 "$SECRET_PATH"
  echo "Reusing existing $SECRET_PATH (perms fixed to 600)"
fi

# --- Step 2: append loader lines (idempotent) -------------------------------
ADDED_ENV_NAMES=()
for ENV_NAME in "${ENV_NAMES[@]}"; do
  ZSH_LINE='[[ -f "$HOME/.secrets/'"$SECRET_FILE"'" ]] && export '"$ENV_NAME"'="$(cat "$HOME/.secrets/'"$SECRET_FILE"'")"'
  FISH_LINE='load_secret '"$ENV_NAME"' "$HOME/.secrets/'"$SECRET_FILE"'"'

  added_any=0
  if grep -qE "(^|[[:space:]])export[[:space:]]+$ENV_NAME=" "$ZSHENV"; then
    echo "  zshenv: $ENV_NAME already present, skipping"
  else
    echo "$ZSH_LINE" >> "$ZSHENV"
    echo "  zshenv: added export $ENV_NAME"
    added_any=1
  fi

  if grep -qE "^load_secret[[:space:]]+$ENV_NAME[[:space:]]" "$FISH_CONF"; then
    echo "  fish:   $ENV_NAME already present, skipping"
  else
    echo "$FISH_LINE" >> "$FISH_CONF"
    echo "  fish:   added load_secret $ENV_NAME"
    added_any=1
  fi

  (( added_any )) && ADDED_ENV_NAMES+=("$ENV_NAME")
done

# --- Step 3: apply chezmoi scoped to only these two files -------------------
echo
echo "Applying chezmoi..."
chezmoi apply "$HOME/.zshenv" "$HOME/.config/fish/config.fish"

# --- Step 4: commit ---------------------------------------------------------
if (( ${#ADDED_ENV_NAMES[@]} == 0 )); then
  echo "No new env vars added — nothing to commit."
elif (( DO_COMMIT )); then
  JOINED=$(IFS=", "; echo "${ADDED_ENV_NAMES[*]}")
  git -C "$CHEZMOI_SRC" add dot_zshenv private_dot_config/private_fish/config.fish
  git -C "$CHEZMOI_SRC" commit -m "feat(fish,zsh): add $JOINED"
  echo "Committed in chezmoi source."
else
  echo "Skipping commit (--no-commit)."
fi

echo
echo "✓ Done. Open a fresh shell (exec zsh -l / exec fish -l) to pick up new env vars."
for ENV_NAME in "${ENV_NAMES[@]}"; do
  printf "  %s → %s\n" "$ENV_NAME" "$SECRET_PATH"
done
