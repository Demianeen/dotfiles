# Homebrew must be in PATH before mise, since mise is installed via brew
export PATH="/opt/homebrew/bin:$PATH"

# pnpm (standalone install lives outside mise shims)
export PNPM_HOME="/Users/demian/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# load mise in any env
eval "$(mise activate zsh --shims)"

# Load secrets
[[ -f "$HOME/.secrets/gemini-api-key" ]] && export GEMINI_API_KEY="$(cat "$HOME/.secrets/gemini-api-key")"
[[ -f "$HOME/.secrets/gemini-api-key" ]] && export GOOGLE_AI_API_KEY="$(cat "$HOME/.secrets/gemini-api-key")"
[[ -f "$HOME/.secrets/openai-api-key" ]] && export OPENAI_API_KEY="$(cat "$HOME/.secrets/openai-api-key")"


# sketchybar event sender
function brew() {
	command brew "$@"

	if [[ $* =~ "upgrade" ]] || [[ $* =~ "update" ]] || [[ $* =~ "outdated" ]]; then
		command sketchybar --trigger brew_update
	fi
	if [[ $* =~ "upgrade" ]] then
		nvim --headless '+Lazy! update' +qa
		brew bundle dump --force --file=/Users/demian/.local/share/chezmoi/Brewfile
	fi
}


# yazi autocd
function ya() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

function wezterm_update_icon() {
	cd ~/.config/wezterm/icon
	command make install
}

function sketchybar_update_icons() {
	cd ~/.config/sketchybar-app-font
	command npm install
	command npm run build:install
	command cp dist/sketchybar-app-font.ttf $HOME/Library/Fonts/
	command cp dist/icon_map.lua $DOTFILES_SRC_PATH/dot_config/sketchybar/items/left/spaces/
}

function yabai_sudoers() {
	# https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
	echo "demian ALL=(root) NOPASSWD: sha256:$(shasum -a 256 $(which yabai)) --load-sa" | pbcopy
	command sudo visudo -f /private/etc/sudoers.d/yabai
}
